{
  "name": "treatmentlane-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-punctuation.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file=.env.local database/migrate.mjs",
    "db:import-providers": "node --env-file=.env.local database/import-providers.mjs",
    "db:verification-queue": "node --env-file=.env.local database/verification-queue.mjs",
    "db:listing-report": "node --env-file=.env.local database/listing-event-report.mjs",
    "db:clean-punctuation": "node --env-file=.env.local database/clean-punctuation.mjs",
    "db:migrate-provider-images:r2": "node --env-file=.env.local database/migrate-provider-images-to-r2.mjs",
    "db:reapply-provider-images:r2": "node --env-file=.env.local database/reapply-r2-provider-images.mjs",
    "db:restore-provider-images": "node --env-file=.env.local database/restore-provider-images-from-backup.mjs",
    "check:punctuation": "node scripts/check-punctuation.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "nodemailer": "^10.1.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^6.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "typescript": "^5",
    "zipcodes": "^8.0.0"
  }
}
